      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~196646~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "DirectoryType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "目录类型。"
    },
    {
      "name": "DirectoryStatus",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "目录状态，和`Status`相同。"
