{
  "name": "CreateAndBindNasFileSystem",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "FileSystemName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "NAS文件系统名称。"
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "NAS文件系统描述。"
    },
    {
      "name": "StorageType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "NAS文件系统的存储规格类型。"
    },
    {
      "name": "EncryptType",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "文件系统是否使用KMS服务托管密钥，对文件系统落盘数据进行加密存储。在读写加密数据时，无需解密。\n\n> 当`FileSystemType`为`standard`或`extreme`时，支持NAS托管密钥；当`FileSystemType`为`extreme`时，支持用户管理密钥。"
    },
    {
      "name": "OfficeSiteId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "办公网络ID。"
    },
    {
      "name": "DesktopGroupId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "共享型云电脑ID。"
    },
    {
      "name": "EndUserIds",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "用户ID列表。"
    }
  ]
}