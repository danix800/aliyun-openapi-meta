{
  "name": "UntagResources",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~196646~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "ResourceType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "资源类型。"
    },
    {
      "name": "All",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否解绑资源上的所有标签。仅当未设置TagKey.N时，该参数生效。默认为false。"
    },
    {
      "name": "ResourceId",
      "position": "Query",
      "type": "Array",
      "required": true,
      "description": "资源ID列表，即云电脑ID列表。可包含1\\~50个。"
    },
    {
      "name": "TagKey",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "标签键。可包含1\\~20个。"
    }
  ]
}