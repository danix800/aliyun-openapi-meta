{
  "name": "ModifyBundle",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~196646~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "BundleId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "云电脑模板ID。"
    },
    {
      "name": "ImageId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "新的镜像ID。新镜像需满足以下条件：\n\n- 新镜像的状态必须为可用（Available）。\n\n- 新镜像的操作系统必须与原镜像相同。\n\n- 新镜像对应所需的磁盘大小不能大于原镜像。\n\n- 新镜像的GPU类型必须与原镜像相同。"
    },
    {
      "name": "BundleName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "新的云电脑模板名称。"
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "新的云电脑模板描述。"
    },
    {
      "name": "Language",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "操作系统语言。目前只支持系统镜像。"
    }
  ]
}