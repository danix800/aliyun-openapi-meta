{
  "name": "RenewDesktopGroup",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "DesktopGroupId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "共享型云电脑ID。"
    },
    {
      "name": "Period",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "续费时长。取值范围由参数`PeriodUnit`的值决定。\n\n- `PeriodUnit`为`Month`时，取值范围为：1、2、3、6。\n\n- `PeriodUnit`为`Year`时，取值范围为：1~5。\n\n默认值：1。"
    },
    {
      "name": "PeriodUnit",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "续费时长的单位，即参数`Period`的单位。"
    },
    {
      "name": "AutoPay",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否自动支付。"
    },
    {
      "name": "AutoRenew",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否自动续费。"
    },
    {
      "name": "ResellerOwnerUid",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": ""
    }
  ]
}