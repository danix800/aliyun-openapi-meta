{
  "name": "CreateTemplate",
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "TemplateName",
      "position": "Formdata",
      "type": "String",
      "required": true,
      "description": "模板的名称。必须符合以下要求：\n\n- 长度2~126个英文或中文字符。\n- 必须以大小写字母或中文开头，不能以`http://`和`https://`开头。\n- 可以包含字母、数字、汉字、半角冒号（:）、下划线（_）或短划线（-），不支持点号（.）。"
    },
    {
      "name": "Description",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "模板的描述。必须符合以下要求：\n\n- 长度2~256个字符，不能以`http://`和`https://`开头。\n- 支持中文、英文、数字、空格和特殊符号，使用回车换行。"
    },
    {
      "name": "ProductType",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "产品类型。固定填写`CloudDesktop`。"
    },
    {
      "name": "BizType",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "> 该参数暂不对外开放使用。"
    },
    {
      "name": "SystemDiskSize",
      "position": "Formdata",
      "type": "Integer",
      "required": false,
      "description": "系统盘大小。单位：GiB。取值范围: 40~500，每10GiB为一个步长。\n\n> 系统盘大小不能小于配置的镜像大小。"
    },
    {
      "name": "SystemDiskPerformanceLevel",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "系统盘类型。\n\n> 只有高主频和图形型的云电脑规格支持ESSD类型的磁盘。"
    },
    {
      "name": "DataDiskList",
      "position": "Formdata",
      "type": "Array",
      "required": false,
      "description": "数据盘大小和规格配置。"
    },
    {
      "name": "ImageId",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "云电脑镜像ID，可以从镜像管理页面查询， 支持系统镜像、自定义镜像等类型。"
    },
    {
      "name": "DefaultLanguage",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "云电脑启动时设置的默认语言，仅在使用系统镜像创建云电脑的场景下生效。"
    },
    {
      "name": "PolicyGroupId",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "全局类型的策略ID。"
    },
    {
      "name": "TimerGroupId",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "配置组ID。"
    },
    {
      "name": "ResourceGroupId",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": "资源组ID。"
    },
    {
      "name": "ResourceTagList",
      "position": "Formdata",
      "type": "Array",
      "required": false,
      "description": "云电脑标签。Key-Value格式。最多可传入20个标签。"
    },
    {
      "name": "RegionConfigList",
      "position": "Formdata",
      "type": "Array",
      "required": false,
      "description": "地域化的模板信息配置， 支持配置多个。 使用时会根据具体的地域匹配。\n\n> 最多支持20个地域的配置。"
    },
    {
      "name": "SiteConfigList",
      "position": "Formdata",
      "type": "Array",
      "required": false,
      "description": "区域配置管理"
    },
    {
      "name": "ChargeType",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": ""
    },
    {
      "name": "Period",
      "position": "Formdata",
      "type": "Integer",
      "required": false,
      "description": ""
    },
    {
      "name": "PeriodUnit",
      "position": "Formdata",
      "type": "String",
      "required": false,
      "description": ""
    },
    {
      "name": "AutoPay",
      "position": "Formdata",
      "type": "Boolean",
      "required": false,
      "description": ""
    },
    {
      "name": "AutoRenew",
      "position": "Formdata",
      "type": "Boolean",
      "required": false,
      "description": ""
    },
    {
      "name": "UserDuration",
      "position": "Formdata",
      "type": "Integer",
      "required": false,
      "description": ""
    },
    {
      "name": "PostPaidAfterUsedUp",
      "position": "Formdata",
      "type": "Boolean",
      "required": false,
      "description": ""
    }
  ]
}