{
  "name": "PullLogs",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "project",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": "Project名称。"
    },
    {
      "name": "logStore",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": "Logstore名称。"
    },
    {
      "name": "shardId",
      "position": "Path",
      "type": "Integer",
      "required": true,
      "description": "日志库的分片 id。"
    },
    {
      "name": "cursor",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "游标，表示从什么位置开始读取数据，相当于起点。"
    },
    {
      "name": "count",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": "返回的Loggroup数目，最小值为1，最大值为1000。"
    },
    {
      "name": "end_cursor",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "结束游标，表示读取数据到什么地方结束，相当于终点。"
    },
    {
      "name": "query",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "过滤语句，spl 语法，请参见[SPL指令](~~2536530~~)"
    },
    {
      "name": "Accept-Encoding",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": "期望服务端返回的数据压缩格式，支持 lz4"
    }
  ]
}