{
  "name": "ListAlerts",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": "Project名称"
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "查询开始行。默认值为0。"
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "分页查询时，设置的每页行数。最大值为200。默认值为10。"
    },
    {
      "name": "logstore",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "获取指定Logstore下的告警规则。默认值为空。"
    }
  ]
}