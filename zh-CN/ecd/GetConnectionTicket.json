{
  "name": "GetConnectionTicket",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~196646~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "ClientId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "客户端生成的唯一ID。"
    },
    {
      "name": "SessionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "会话ID。调用GetLoginToken获取"
    },
    {
      "name": "LoginToken",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "登录凭证。调用GetLoginToken获取"
    },
    {
      "name": "TaskId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑连接任务ID。     \n首次调用本接口时无需配置，后续调用本接口时配置为上一次调用本接口返回的`TaskId`。"
    },
    {
      "name": "DesktopId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑ID。"
    },
    {
      "name": "ClientOS",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "客户端操作系统。"
    },
    {
      "name": "ClientVersion",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "客户端版本。"
    },
    {
      "name": "ClientType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "客户端类型。"
    },
    {
      "name": "CommandContent",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "当前参数可以配置自定义用户态应用，当成功获取凭证后，自动执行应用。\n\n- appPath：String类型，应用启动文件路径，例如：`\"C:\\\\Program Files (x86)\\\\000\\\\000.exe\"`，注意路径分隔符要用双斜杠（\\\\\\）。\n- appParameter：String类型，应用启动参数，例如：`\"meetingid 000 meetingname aaa\"`，注意参数与参数之间直接用空格。"
    },
    {
      "name": "Uuid",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "客户端唯一标识。若使用无影客户端，可在客户端登录界面的**关于**对话框中查看该参数。"
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "标签列表。可包含1\\~20个。"
    }
  ]
}