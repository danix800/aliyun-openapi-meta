{
  "name": "DescribeDesktopTypes",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "DesktopTypeId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "规格ID。\n\n> 当`InstanceTypeFamily`和`DesktopTypeId`参数的取值均为空时，将查询云电脑所有规格的信息。"
    },
    {
      "name": "InstanceTypeFamily",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "规格族名称。\n\n> 当`InstanceTypeFamily`和`DesktopTypeId`参数的取值均为空时，将查询云电脑所有规格的信息。"
    },
    {
      "name": "CpuCount",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "vCPU数量。"
    },
    {
      "name": "MemorySize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "内存大小。单位为MiB。"
    },
    {
      "name": "GpuCount",
      "position": "Query",
      "type": "Number",
      "required": false,
      "description": "GPU核数。"
    },
    {
      "name": "DesktopIdForModify",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "变配时传入需要变配的云电脑ID，返回值会增加规格与云电脑之间是否兼容的信息。"
    },
    {
      "name": "OrderType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "订单类型。"
    },
    {
      "name": "AppliedScope",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "规格适用范围。默认值：`Public`。"
    },
    {
      "name": "DesktopGroupIdForModify",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "变配时传入需要变配的共享型云电脑ID，返回值会增加规格与共享型云电脑之间是否兼容的信息。"
    },
    {
      "name": "GpuDriverType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "GPU驱动类型。"
    },
    {
      "name": "OrderBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "排序字段，若不指定则按照创建时间倒序排列。"
    },
    {
      "name": "SortType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "排序方式。"
    },
    {
      "name": "Scope",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "规格的售卖方式。"
    },
    {
      "name": "DesktopTypeIdList",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "规格ID列表。"
    },
    {
      "name": "SupportMinSessionCount",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "查询规则支持的多会话数量。"
    },
    {
      "name": "ZoneId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "> 该参数未对外开放使用。"
    },
    {
      "name": "GpuMemory",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": ""
    },
    {
      "name": "ScopeSet",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": ""
    }
  ]
}