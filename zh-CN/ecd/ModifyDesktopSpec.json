{
  "name": "ModifyDesktopSpec",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "DesktopId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑ID。"
    },
    {
      "name": "DesktopType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "目标规格。您可以调用[DescribeDesktopTypes](~~DescribeDesktopTypes~~)查询云电脑支持的规格。"
    },
    {
      "name": "RootDiskSizeGib",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "目标系统盘容量，单位为GiB。取值范围：80\\~500 GiB，且必须为10的倍数。"
    },
    {
      "name": "UserDiskSizeGib",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "目标数据盘容量，单位为GiB。\n\n- 对于非图形型规格，取值范围为20\\~1020 GiB，且必须为10的倍数。\n- 对于图形型规格，取值范围为40\\~1020 GiB，且必须为10的倍数。"
    },
    {
      "name": "AutoPay",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否自动支付。"
    },
    {
      "name": "UserDiskPerformanceLevel",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "数据盘性能等级。"
    },
    {
      "name": "PromotionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "优惠活动ID。"
    },
    {
      "name": "ResourceSpecs",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "资源规格模板列表。"
    },
    {
      "name": "ResourceType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "资源类型。\n\n> 非按月购买云电脑可不填。"
    },
    {
      "name": "ResellerOwnerUid",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": ""
    }
  ]
}