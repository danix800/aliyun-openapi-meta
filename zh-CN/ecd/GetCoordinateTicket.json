{
  "name": "GetCoordinateTicket",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~196646~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "CoId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "协同流ID。来自接口[ApplyCoordinationForMonitoring](~~ApplyCoordinationForMonitoring~~)返回的`Coid`。"
    },
    {
      "name": "TaskId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑连接任务ID。首次请求时不需要填写。首次请求如果没有返回Ticket，则后续请求根据首次返回的`TaskId`填写。"
    },
    {
      "name": "EndUserId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "终端用户的用户名。管理员侧不需要。"
    },
    {
      "name": "UserType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "用户类型。"
    }
  ]
}