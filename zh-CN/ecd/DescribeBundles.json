{
  "name": "DescribeBundles",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "MaxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "分页查询时，每页最大行数。\n\n- 最大值：100\n- 默认值：10"
    },
    {
      "name": "NextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "下一个查询开始的Token。"
    },
    {
      "name": "BundleType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑模板类型。"
    },
    {
      "name": "DesktopTypeFamily",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑规格族。"
    },
    {
      "name": "CpuCount",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "云电脑规格包含的vCPU数量。"
    },
    {
      "name": "MemorySize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "云电脑规格包含的内存大小。单位为GiB。"
    },
    {
      "name": "GpuCount",
      "position": "Query",
      "type": "Number",
      "required": false,
      "description": "云电脑规格包含的GPU个数。"
    },
    {
      "name": "CheckStock",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否查询云电脑规格的库存状态。"
    },
    {
      "name": "FromDesktopGroup",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否属于云电脑池。"
    },
    {
      "name": "ProtocolType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "协议类型。"
    },
    {
      "name": "BundleId",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "云电脑模板ID列表。可设置1\\~100个。"
    },
    {
      "name": "SupportMultiSession",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "查询云电脑列表时是否返回多会话的云电脑模板。默认不返回。"
    },
    {
      "name": "VolumeEncryptionEnabled",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否开启磁盘加密。"
    },
    {
      "name": "FotaChannel",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "> 此参数暂未对外开放使用。"
    },
    {
      "name": "SelectedBundle",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "精选模板。"
    },
    {
      "name": "SessionType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "会话类型。"
    },
    {
      "name": "ImageId",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "镜像ID列表。"
    },
    {
      "name": "OsType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "操作系统类型。"
    },
    {
      "name": "Scope",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "使用场景。"
    },
    {
      "name": "GpuDriverType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "GPU驱动类型。"
    }
  ]
}