{
  "name": "DescribeDesktops",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "GroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑池ID。"
    },
    {
      "name": "DesktopStatus",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑状态。"
    },
    {
      "name": "MaxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "分页查询时每页行数。\n\n- 最大值：100\n- 默认值：10"
    },
    {
      "name": "NextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "下一个查询开始的Token，NextToken为空表示没有下一个。"
    },
    {
      "name": "UserName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "用户名称。"
    },
    {
      "name": "DesktopName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑名称。"
    },
    {
      "name": "DirectoryId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "目录ID。同办公网络ID。"
    },
    {
      "name": "OfficeSiteId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "办公网络ID。"
    },
    {
      "name": "OfficeSiteName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "办公网络名称。"
    },
    {
      "name": "PolicyGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑策略ID。"
    },
    {
      "name": "ChargeType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑的计费方式。"
    },
    {
      "name": "ExpiredTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "包年包月云电脑的到期时间。"
    },
    {
      "name": "ProtocolType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "协议类型。\n"
    },
    {
      "name": "DesktopId",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "云电脑ID。可设置1~100个。"
    },
    {
      "name": "EndUserId",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "云电脑的授权用户列表。可设置1~100个。\n\n> 在同一时段内，只有一个用户可以连接和使用该云电脑。"
    },
    {
      "name": "ExcludedEndUserId",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "要排除的云电脑授权用户列表。可设置1~100个。"
    },
    {
      "name": "FilterDesktopGroup",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否排除池化云电脑（云电脑池中的云电脑）。"
    },
    {
      "name": "ManagementFlag",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "管理标识。"
    },
    {
      "name": "QueryFotaUpdate",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否查询云电脑镜像版本信息。"
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "标签列表。一个标签由一对键值对组成，用于标记资源。您可以使用标签来分组管理云电脑，便于搜索和批量操作，详情参见[使用标签管理云电脑](~~203781~~)。"
    },
    {
      "name": "SnapshotPolicyId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "快照策略ID。"
    },
    {
      "name": "OnlyDesktopGroup",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否只查询池化云电脑（云电脑池中的云电脑）。"
    },
    {
      "name": "DesktopGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑池ID。如果传入了`DesktopId`，则忽略该`DesktopGroupId`；如果`DesktopId`为空，则会根据`DesktopGroupId`去获取该云电脑池内所有云电脑的`DesktopId`。"
    },
    {
      "name": "OsTypes",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "操作系统类型。"
    },
    {
      "name": "DesktopType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑规格。您可以调用[DescribeDesktopTypes](~~188882~~)查询云电脑支持的规格ID。"
    },
    {
      "name": "ImageId",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "镜像ID列表。"
    },
    {
      "name": "DesktopStatusList",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": "云电脑状态列表。"
    },
    {
      "name": "GpuInstanceGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "弹性显卡池ID。"
    },
    {
      "name": "QosRuleId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "公网限速规则ID。"
    },
    {
      "name": "SubPayType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "云电脑购买方式。"
    },
    {
      "name": "ResourceGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "企业资源组ID。"
    },
    {
      "name": "FillResourceGroup",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否查询企业资源组信息。"
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "分页查询时，当前页的页码。"
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "分页查询时，每页最大行数。"
    },
    {
      "name": "MultiResource",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否有多个资源。"
    }
  ]
}