{
  "name": "RenewNetworkPackages",
  "protocol": "HTTP|HTTPS",
  "method": "POST|GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "地域ID。可以调用[DescribeRegions](~~196646~~)获取无影云电脑支持的地域列表。"
    },
    {
      "name": "Period",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "续费时长。取值范围由参数`PeriodUnit`的值决定。\n\n- `PeriodUnit`为`Week`时，取值范围为：1。\n- `PeriodUnit`为`Month`时，取值范围为：1、2、3、6。\n- `PeriodUnit`为`Year`时，取值范围为：1、2、3。\n\n默认值：1。"
    },
    {
      "name": "PeriodUnit",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "续费时长单位。"
    },
    {
      "name": "AutoPay",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": "是否自动支付。"
    },
    {
      "name": "NetworkPackageId",
      "position": "Query",
      "type": "Array",
      "required": true,
      "description": "公网精品带宽ID列表。可设置1~100个。"
    },
    {
      "name": "PromotionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "优惠ID。"
    },
    {
      "name": "ResellerOwnerUid",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": ""
    },
    {
      "name": "AutoRenew",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": ""
    }
  ]
}