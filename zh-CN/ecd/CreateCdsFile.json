    },
    {
      "name": "CdsId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "企业网盘ID。"
    },
    {
      "name": "FileName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "文件名称。"
    },
    {
      "name": "FileType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": "文件类型。"
    },
    {
      "name": "ParentFileId",
      "position": "Query",
