{
  "name": "ListMetricStores",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": "日志项目名称"
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "查询分页的起始位置"
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": "查询分页的页大小，一次请求最多返回的时序库数量"
    },
    {
      "name": "mode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "要查询的时序库规格类型，例如 standard"
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": "要查询的时序库名称，支持模糊查询，此参数为空或者不传递此参数表示查询所有时序库"
    }
  ]
}